{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json",
  "title": "OAW Execution Graph v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "host_evidence_digest", "registry_digest", "taxonomy_version", "recipe_id", "recipe_version", "recipe_digest", "selection", "provider_instances", "entry_slot_id", "slots", "incident_routes", "stable_boundaries", "topology", "environment_requirements", "decisions", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.execution-graph/v4"},
    "host_id": {"$ref": "#/$defs/id"},
    "host_evidence_digest": {"$ref": "#/$defs/digest"},
    "registry_digest": {"$ref": "#/$defs/digest"},
    "taxonomy_version": {"const": "oaw.lifecycle-taxonomy/v1"},
    "recipe_id": {"$ref": "#/$defs/qualified_id"},
    "recipe_version": {"type": "string", "minLength": 1},
    "recipe_digest": {"$ref": "#/$defs/digest"},
    "selection": {"$ref": "#/$defs/selection"},
    "provider_instances": {"type": "array", "items": {"$ref": "#/$defs/provider_instance"}},
    "entry_slot_id": {"$ref": "#/$defs/slot_id"},
    "slots": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/slot"}},
    "incident_routes": {"type": "array", "items": {"$ref": "#/$defs/incident_route"}},
    "stable_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "topology": {"$ref": "#/$defs/topology"},
    "environment_requirements": {"type": "array", "items": {"$ref": "#/$defs/environment_requirement"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9.-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "revision": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|sha256:[0-9a-f]{64})$"},
    "topology": {"enum": ["CURRENT", "SUBAGENT"]},
    "slot_id": {"enum": ["problem-framing", "solution-specification", "delivery-planning", "workspace-preparation", "implementation", "implementation-tdd", "incident-recovery", "review-remediation", "fresh-verification", "closeout"]},
    "binding_selector": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "binding_id"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "binding_id": {"$ref": "#/$defs/id"}}
    },
    "alternative": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "step_id", "alternative_id", "selector"],
      "properties": {"slot_id": {"$ref": "#/$defs/slot_id"}, "step_id": {"$ref": "#/$defs/id"}, "alternative_id": {"$ref": "#/$defs/id"}, "selector": {"$ref": "#/$defs/binding_selector"}}
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "recipe_id", "recipe_digest", "topology", "add_ons", "alternatives", "overlays", "digest"],
      "properties": {
        "profile": {"type": "string", "minLength": 1}, "recipe_id": {"$ref": "#/$defs/qualified_id"}, "recipe_digest": {"$ref": "#/$defs/digest"},
        "topology": {"$ref": "#/$defs/topology"}, "add_ons": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "alternatives": {"type": "array", "items": {"$ref": "#/$defs/alternative"}}, "overlays": {"type": "array", "items": {"$ref": "#/$defs/id"}}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "provider_instance": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "host_id", "instance_digest"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/id"}, "instance_digest": {"$ref": "#/$defs/digest"}}
    },
    "cursor": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "kind", "unit_id", "ordinal"],
      "properties": {"slot_id": {"$ref": "#/$defs/slot_id"}, "kind": {"enum": ["binding", "host-action", "gate", "terminal"]}, "unit_id": {"type": "string", "minLength": 1}, "ordinal": {"type": "integer", "minimum": 1}}
    },
    "responsibility": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "name", "slot_id", "outcome_owner"],
      "properties": {"namespace": {"enum": ["stage", "procedure", "incident", "assurance", "host-action", "gate"]}, "name": {"type": "string", "minLength": 1}, "slot_id": {"$ref": "#/$defs/slot_id"}, "outcome_owner": {"type": "boolean"}}
    },
    "delegation": {
      "type": "object", "additionalProperties": false,
      "required": ["child", "parallel_child", "nested_child", "nested_parallel_child"],
      "properties": {"child": {"type": "boolean"}, "parallel_child": {"type": "boolean"}, "nested_child": {"type": "boolean"}, "nested_parallel_child": {"type": "boolean"}}
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["cursor", "unit_id", "step_id", "anchor_slot_id", "slot_ids", "provider_id", "provider_instance_digest", "binding_id", "distribution_id", "distribution_revision", "distribution_tree_digest", "surface", "kind", "reference", "invocation", "binding_tree_digest", "input_artifact", "output_artifact", "responsibilities", "maximum_effects", "resources", "supported_topologies", "delegation", "required_features", "feature_evidence_digests", "disposition", "requires_explicit_invocation", "binding_evidence_digest"],
      "properties": {
        "cursor": {"$ref": "#/$defs/cursor"}, "unit_id": {"type": "string", "minLength": 1}, "step_id": {"$ref": "#/$defs/id"}, "anchor_slot_id": {"$ref": "#/$defs/slot_id"},
        "slot_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slot_id"}}, "provider_id": {"$ref": "#/$defs/qualified_id"}, "provider_instance_digest": {"$ref": "#/$defs/digest"},
        "binding_id": {"$ref": "#/$defs/id"}, "distribution_id": {"$ref": "#/$defs/id"}, "distribution_revision": {"$ref": "#/$defs/revision"}, "distribution_tree_digest": {"$ref": "#/$defs/tree_digest"},
        "surface": {"$ref": "#/$defs/id"}, "kind": {"enum": ["skill", "agent", "role", "instruction", "tool"]}, "reference": {"type": "string", "minLength": 1}, "invocation": {"enum": ["human-explicit", "model", "host", "internal"]},
        "binding_tree_digest": {"$ref": "#/$defs/tree_digest"}, "input_artifact": {"type": "string", "minLength": 1}, "output_artifact": {"type": "string", "minLength": 1},
        "responsibilities": {"type": "array", "items": {"$ref": "#/$defs/responsibility"}}, "maximum_effects": {"type": "array", "items": {"type": "string", "minLength": 1}}, "resources": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "supported_topologies": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/topology"}}, "delegation": {"$ref": "#/$defs/delegation"},
        "required_features": {"type": "array", "items": {"enum": ["child-delegation", "parallel-child-delegation", "nested-child-delegation", "nested-parallel-child-delegation"]}},
        "feature_evidence_digests": {"type": "array", "items": {"$ref": "#/$defs/digest"}}, "disposition": {"enum": ["dispatch", "credited-internal", "omitted"]},
        "macro_mode": {"enum": ["", "credit-only", "dispatch-before", "dispatch-after"]}, "parent_unit_id": {"type": "string"}, "requires_explicit_invocation": {"type": "boolean"}, "binding_evidence_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "owner": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "unit_id"],
      "properties": {"kind": {"enum": ["provider-binding", "host-action", "none"]}, "unit_id": {"type": "string"}, "provider_id": {"type": "string"}, "binding_id": {"type": "string"}, "host_action_id": {"type": "string"}}
    },
    "host_action": {
      "type": "object", "additionalProperties": false,
      "required": ["cursor", "id", "input_artifact", "output_artifact", "input_schema", "outcome_schema", "maximum_effects", "resources", "observation_digest"],
      "properties": {"cursor": {"$ref": "#/$defs/cursor"}, "id": {"$ref": "#/$defs/id"}, "input_artifact": {"type": "string", "minLength": 1}, "output_artifact": {"type": "string", "minLength": 1}, "input_schema": {"type": "string", "minLength": 1}, "outcome_schema": {"type": "string", "minLength": 1}, "maximum_effects": {"type": "array", "items": {"type": "string"}}, "resources": {"type": "array", "items": {"type": "string"}}, "observation_digest": {"$ref": "#/$defs/digest"}}
    },
    "evidence_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "minimum", "description"],
      "properties": {"kind": {"type": "string", "minLength": 1}, "minimum": {"type": "integer", "minimum": 1}, "description": {"type": "string", "minLength": 1}}
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["cursor", "id", "authority", "predicate", "evidence_requirements"],
      "properties": {"cursor": {"$ref": "#/$defs/cursor"}, "id": {"$ref": "#/$defs/id"}, "authority": {"enum": ["oaw-core", "host", "user"]}, "predicate": {"type": "string", "minLength": 1}, "evidence_requirements": {"type": "array", "items": {"$ref": "#/$defs/evidence_requirement"}}}
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["signal", "target"], "properties": {"signal": {"type": "string", "minLength": 1}, "target": {"$ref": "#/$defs/slot_id"}}
    },
    "slot": {
      "type": "object", "additionalProperties": false,
      "required": ["slot_id", "applicability", "active", "entry_artifact", "outcome_artifact", "outcome_owner", "pipeline", "gates", "transitions", "terminal", "traversal"],
      "properties": {
        "slot_id": {"$ref": "#/$defs/slot_id"}, "applicability": {"enum": ["mandatory", "conditional"]}, "active": {"type": "boolean"}, "entry_artifact": {"type": "string"}, "outcome_artifact": {"type": "string"},
        "outcome_owner": {"$ref": "#/$defs/owner"}, "pipeline": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "host_action": {"$ref": "#/$defs/host_action"},
        "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}, "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}, "terminal": {"type": "boolean"}, "traversal": {"type": "array", "items": {"$ref": "#/$defs/cursor"}}
      }
    },
    "incident_route": {
      "type": "object", "additionalProperties": false,
      "required": ["incident_type", "handler_slot_id", "handler_pipeline", "return_to", "if_unavailable"],
      "properties": {"incident_type": {"type": "string", "minLength": 1}, "handler_slot_id": {"const": "incident-recovery"}, "handler_pipeline": {"type": "array", "items": {"$ref": "#/$defs/cursor"}}, "return_to": {"$ref": "#/$defs/slot_id"}, "if_unavailable": {"enum": ["stop", "replan"]}}
    },
    "environment_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "required", "accepted_dispositions"],
      "properties": {"surface": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}, "accepted_dispositions": {"type": "array", "items": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]}}}
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["disposition", "reason_code", "detail"],
      "properties": {"slot_id": {"type": "string"}, "step_id": {"type": "string"}, "unit_id": {"type": "string"}, "add_on_id": {"type": "string"}, "alternative_id": {"type": "string"}, "overlay_id": {"type": "string"}, "incident_type": {"type": "string"}, "disposition": {"enum": ["dispatch", "credited-internal", "omitted"]}, "reason_code": {"type": "string", "minLength": 1}, "detail": {"type": "string", "minLength": 1}}
    }
  }
}
