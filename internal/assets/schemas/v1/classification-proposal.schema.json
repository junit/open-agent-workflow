{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/classification-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "traits", "resources", "evidence"],
  "properties": {
    "schema_version": {"const": "oaw.classification-proposal/v1"},
    "traits": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/trait"}},
    "resources": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["project", "project-worktree", "git-repository", "public-api", "schema", "dependency", "security", "data", "deployment", "credentials", "network", "destructive"]}},
    "evidence": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence"}},
    "capability_selector": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/selector"}]}
  },
  "$defs": {
    "trait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trait", "value"],
      "properties": {
        "trait": {"enum": ["scope-clear", "change-point-known", "recoverable", "focused-verification-known", "bounded-capability-request", "architecture-decision", "public-contract-change", "schema-change", "dependency-change", "security-sensitive", "data-sensitive", "deployment-change", "domain-uncertainty", "root-cause-uncertain", "multiple-responsibilities", "multiple-tickets", "long-lived-delegation", "destructive-mutation", "critical-release"]},
        "value": {"enum": ["true", "false", "unknown"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference", "digest"],
      "properties": {
        "kind": {"enum": ["scope", "change-point", "verification", "capability-selector", "security-acceptance", "negative-test", "architecture", "authorization", "recovery"]},
        "reference": {"type": "string", "minLength": 1, "maxLength": 512},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "capability_id", "source"],
      "properties": {
        "provider_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
        "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
        "source": {"enum": ["user-intent", "trusted-rule"]}
      }
    }
  }
}
