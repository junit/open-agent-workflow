{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/workflow-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "message_id", "idempotency_key", "workflow_id", "expected_revision"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-command/v1"},
    "kind": {"enum": ["START", "INSPECT", "PREPARE", "RECEIPT", "SWITCH", "CANCEL"]},
    "message_id": {"$ref": "#/$defs/optional_text"},
    "idempotency_key": {"$ref": "#/$defs/optional_text"},
    "workflow_id": {"$ref": "#/$defs/optional_text"},
    "expected_revision": {"type": "integer", "minimum": 0},
    "start": {"$ref": "#/$defs/start"},
    "prepare": {"$ref": "#/$defs/prepare"},
    "receipt": {"$ref": "#/$defs/receipt_input"},
    "switch": {"$ref": "#/$defs/switch"},
    "cancel": {"$ref": "#/$defs/cancel"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "START"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"const": ""}, "expected_revision": {"const": 0}}, "required": ["start", "message_id", "idempotency_key"], "not": {"anyOf": [{"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "INSPECT"}, "message_id": {"const": ""}, "idempotency_key": {"const": ""}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"const": 0}}, "required": ["workflow_id"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "PREPARE"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"minimum": 1}}, "required": ["prepare"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["receipt"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "RECEIPT"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"minimum": 1}}, "required": ["receipt"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "SWITCH"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"minimum": 1}}, "required": ["switch"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "CANCEL"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"minimum": 1}}, "required": ["cancel"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["switch"]}]}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "optional_text": {"type": "string", "maxLength": 512, "pattern": "^(?:|\\S(?:.*\\S)?)$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "profile_source", "topology", "topology_source", "add_ons", "bindings"],
      "properties": {
        "profile": {"$ref": "#/$defs/text"},
        "profile_source": {"const": "user-selection"},
        "topology": {"enum": ["CURRENT", "SUBAGENT"]},
        "topology_source": {"enum": ["user-selection", "host-only-option"]},
        "add_ons": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "bindings": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["selector", "preferred_provider_id"],
      "properties": {
        "selector": {"$ref": "#/$defs/selector"},
        "preferred_provider_id": {"$ref": "#/$defs/qualified_id"}
      }
    },
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "capability_id"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}}
    },
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "start": {
      "type": "object", "additionalProperties": false,
      "required": ["request_id", "deliverable_id", "input_digest", "active_ticket", "proposal", "selection", "host_session", "environment"],
      "properties": {
        "request_id": {"$ref": "#/$defs/text"}, "deliverable_id": {"$ref": "#/$defs/text"},
        "input_digest": {"$ref": "#/$defs/digest"}, "active_ticket": {"$ref": "#/$defs/optional_text"},
        "proposal": {"$ref": "https://open-agent-workflow.dev/schemas/v1/classification-proposal.schema.json"},
        "selection": {"$ref": "#/$defs/selection"},
        "host_session": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-session.schema.json"},
        "environment": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-environment-report.schema.json"}
      }
    },
    "prepare": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_effects", "requested_resources", "termination_condition", "input_references", "evidence_requirements"],
      "properties": {
        "requested_effects": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "requested_resources": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "termination_condition": {"$ref": "#/$defs/text"},
        "input_references": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/artifact_reference"}},
        "evidence_requirements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence_requirement"}}
      }
    },
    "artifact_reference": {
      "type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"],
      "properties": {"kind": {"$ref": "#/$defs/text"}, "reference": {"type": "string", "minLength": 1, "maxLength": 2048}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "evidence_requirement": {
      "type": "object", "additionalProperties": false, "required": ["kind", "minimum", "description"],
      "properties": {"kind": {"$ref": "#/$defs/text"}, "minimum": {"type": "integer", "minimum": 1}, "description": {"$ref": "#/$defs/text"}}
    },
    "receipt_input": {
      "type": "object", "additionalProperties": false, "required": ["receipt", "signal", "stable_boundary"],
      "properties": {"receipt": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-invocation-receipt.schema.json"}, "signal": {"$ref": "#/$defs/optional_text"}, "stable_boundary": {"$ref": "#/$defs/optional_text"}}
    },
    "switch": {
      "type": "object", "additionalProperties": false, "required": ["boundary", "selection", "host_session", "environment"],
      "properties": {"boundary": {"$ref": "#/$defs/text"}, "selection": {"$ref": "#/$defs/selection"}, "host_session": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-session.schema.json"}, "environment": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-environment-report.schema.json"}}
    },
    "cancel": {
      "type": "object", "additionalProperties": false, "required": ["reason", "invocation_terminal"],
      "properties": {"reason": {"$ref": "#/$defs/text"}, "invocation_terminal": {"type": "boolean"}}
    }
  }
}
