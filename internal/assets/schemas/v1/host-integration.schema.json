{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/host-integration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integration_version", "id", "manifest", "manifest_digest", "audit", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-integration/v1"},
    "integration_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "id": {"$ref": "#/$defs/qualified_id"},
    "manifest": {"$ref": "https://open-agent-workflow.dev/schemas/v1/host-manifest.schema.json"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "audit": {"$ref": "#/$defs/audit"},
    "conformance": {"$ref": "#/$defs/conformance_report"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"manifest": {"properties": {"integration_level": {"const": "instruction-only"}}}}},
      "then": {
        "properties": {"audit": {"properties": {"status": {"const": "pending"}}}},
        "not": {"required": ["conformance"]}
      },
      "else": {
        "required": ["conformance"],
        "properties": {
          "audit": {"properties": {"status": {"const": "passed"}}},
          "conformance": {"properties": {"passed": {"const": true}}}
        }
      }
    }
  ],
  "$defs": {
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {"type": "string", "minLength": 1, "maxLength": 2048},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references", "digest"],
      "properties": {
        "status": {"enum": ["pending", "passed"]},
        "references": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/audit_reference"}},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"references": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"references": {"minItems": 1}}}}
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "passed", "evidence"],
      "properties": {
        "id": {"enum": ["isolated-executor", "exact-binding-invocation", "pause", "bundle-inheritance", "evidence-return", "invocation-deduplication", "cancellation", "normalized-observation", "provider-binding-inventory", "native-invocation"]},
        "passed": {"type": "boolean"},
        "evidence": {"$ref": "#/$defs/digest"}
      }
    },
    "conformance_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "suite_version", "integration_id", "manifest_digest", "checks", "transcript_digest", "passed", "digest"],
      "properties": {
        "schema_version": {"const": "oaw.host-conformance-report/v1"},
        "suite_version": {"const": "oaw.host-conformance/v1"},
        "integration_id": {"$ref": "#/$defs/qualified_id"},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "checks": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/check"}},
        "transcript_digest": {"$ref": "#/$defs/digest"},
        "passed": {"type": "boolean"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
