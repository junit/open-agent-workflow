{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/workflow-snapshot.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "request_id", "deliverable_id", "revision", "status", "classification", "bundles", "active_generation", "active_node_id", "active_ticket", "grant_history", "receipts", "resource_leases", "last_stable_boundary", "processed_messages", "projection_lag"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-snapshot/v1"},
    "workflow_id": {"$ref": "#/$defs/text"},
    "request_id": {"$ref": "#/$defs/text"},
    "deliverable_id": {"$ref": "#/$defs/text"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["READY", "PREPARED", "IN_FLIGHT", "PAUSED", "FINISHED", "CANCELLED"]},
    "classification": {"$ref": "#/$defs/classification"},
    "bundles": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/bundle"}},
    "active_generation": {"type": "integer", "minimum": 0},
    "active_node_id": {"$ref": "#/$defs/optional_text"},
    "active_ticket": {"$ref": "#/$defs/optional_text"},
    "active_grant": {"anyOf": [{"$ref": "https://open-agent-workflow.dev/schemas/v2/capability-grant.schema.json"}, {"type": "null"}]},
    "grant_history": {"type": "array", "maxItems": 128, "items": {"$ref": "https://open-agent-workflow.dev/schemas/v2/capability-grant.schema.json"}},
    "receipts": {"type": "array", "maxItems": 256, "items": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-invocation-receipt.schema.json"}},
    "resource_leases": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/resource_lease"}},
    "last_stable_boundary": {"$ref": "#/$defs/optional_text"},
    "processed_messages": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/processed_message"}},
    "projection_lag": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/projection_lag"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
    "optional_text": {"type": "string", "maxLength": 2048, "pattern": "^(?:|\\S(?:.*\\S)?)$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "selector": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "capability_id"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}}
    },
    "classification_selector": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "capability_id", "source"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}, "source": {"enum": ["user-intent", "trusted-rule"]}}
    },
    "classification_evidence_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {"kind": {"$ref": "#/$defs/text"}, "reason": {"$ref": "#/$defs/text"}}
    },
    "classification": {
      "type": "object", "additionalProperties": false,
      "required": ["request_mode", "workflow_complexity", "risk_class", "evidence_requirements", "escalation_reasons"],
      "properties": {
        "request_mode": {"enum": ["DIRECT", "BOUNDED", "WORKFLOW"]},
        "workflow_complexity": {"anyOf": [{"enum": ["ordinary", "complex"]}, {"type": "null"}]},
        "risk_class": {"enum": ["normal", "elevated", "critical"]},
        "evidence_requirements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/classification_evidence_requirement"}},
        "escalation_reasons": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/text"}},
        "capability_selector": {"anyOf": [{"$ref": "#/$defs/classification_selector"}, {"type": "null"}]}
      }
    },
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["selector", "preferred_provider_id"],
      "properties": {"selector": {"$ref": "#/$defs/selector"}, "preferred_provider_id": {"$ref": "#/$defs/qualified_id"}}
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["profile", "profile_source", "topology", "topology_source", "add_ons", "bindings"],
      "properties": {
        "profile": {"$ref": "#/$defs/text"}, "profile_source": {"const": "user-selection"},
        "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "topology_source": {"enum": ["user-selection", "host-only-option"]},
        "add_ons": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "bindings": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/binding"}}
      }
    },
    "provider_instance": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "host_id", "instance_digest"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "instance_digest": {"$ref": "#/$defs/digest"}}
    },
    "graph_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["signal", "target"],
      "properties": {"signal": {"$ref": "#/$defs/text"}, "target": {"$ref": "#/$defs/text"}}
    },
    "graph_incident_route": {
      "type": "object", "additionalProperties": false,
      "required": ["incident", "handler"],
      "properties": {"incident": {"$ref": "#/$defs/text"}, "handler": {"$ref": "#/$defs/text"}}
    },
    "environment_requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "required", "accepted_dispositions"],
      "properties": {
        "surface": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"},
        "accepted_dispositions": {"type": "array", "uniqueItems": true, "items": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]}}
      }
    },
    "environment_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["surface", "disposition", "source", "digest"],
      "properties": {"surface": {"$ref": "#/$defs/text"}, "disposition": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]}, "source": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "graph_node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "responsibility", "provider_id", "provider_instance_digest", "capability_id", "binding", "input_schema", "outcome_schema", "maximum_effects", "resources", "request_modes", "supported_topologies", "delegation_allow_list", "transitions"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["phase", "procedure", "incident-handler", "checkpoint", "gate"]}, "responsibility": {"$ref": "#/$defs/text"}, "phase": {"$ref": "#/$defs/optional_text"}, "optional": {"type": "boolean"},
        "provider_id": {"$ref": "#/$defs/qualified_id"}, "provider_instance_digest": {"$ref": "#/$defs/digest"}, "capability_id": {"$ref": "#/$defs/local_id"}, "binding": {"$ref": "#/$defs/host_binding"}, "input_schema": {"$ref": "#/$defs/text"}, "outcome_schema": {"$ref": "#/$defs/text"},
        "maximum_effects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "request_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["BOUNDED", "WORKFLOW"]}}, "supported_topologies": {"type": "array", "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}}, "delegation_allow_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_id"}}, "transitions": {"type": "array", "items": {"$ref": "#/$defs/graph_transition"}}
      }
    },
    "execution_graph": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "host_id", "recipe_id", "recipe_version", "recipe_digest", "entry", "bindings", "provider_instances", "nodes", "incident_routes", "terminal_gates", "stable_boundaries", "eligible_topologies", "environment_requirements", "digest"],
      "properties": {
        "schema_version": {"const": "oaw.execution-graph/v3"}, "host_id": {"$ref": "#/$defs/text"}, "recipe_id": {"$ref": "#/$defs/qualified_id"}, "recipe_version": {"$ref": "#/$defs/text"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "entry": {"$ref": "#/$defs/text"},
        "bindings": {"type": "array", "items": {"$ref": "#/$defs/binding"}}, "provider_instances": {"type": "array", "items": {"$ref": "#/$defs/provider_instance"}}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/graph_node"}}, "incident_routes": {"type": "array", "items": {"$ref": "#/$defs/graph_incident_route"}}, "terminal_gates": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "stable_boundaries": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "eligible_topologies": {"type": "array", "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}}, "environment_requirements": {"type": "array", "items": {"$ref": "#/$defs/environment_requirement"}}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "config_pin": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "host_id", "installation_key", "evidence_digest"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "installation_key": {"$ref": "#/$defs/text"}, "evidence_digest": {"$ref": "#/$defs/digest"}, "location": {"$ref": "#/$defs/optional_text"}, "version": {"$ref": "#/$defs/optional_text"}}
    },
    "provider_installation": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "host_id", "surface_id", "location", "discovery_probe_id"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "surface_id": {"$ref": "#/$defs/text"}, "location": {"$ref": "#/$defs/text"}, "discovery_probe_id": {"$ref": "#/$defs/text"}}
    },
    "binding_preference": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "capability_id", "host_id", "kind", "reference"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}, "host_id": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}}
    },
    "bounded_default": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "provider_id", "capability_id"],
      "properties": {"id": {"$ref": "#/$defs/text"}, "provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}}
    },
    "provider_settings": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "host_id", "disabled", "pin", "preferences", "capability_limit", "digest"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "disabled": {"type": "boolean"}, "pin": {"anyOf": [{"$ref": "#/$defs/config_pin"}, {"type": "null"}]}, "preferences": {"type": "array", "items": {"$ref": "#/$defs/binding_preference"}}, "capability_limit": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "catalog_digest", "user_config_digest", "project_root", "project_config_digest", "project_status", "project_reason", "settings", "provider_installations", "bounded_capability_defaults", "required_providers", "recommended_providers", "untrusted_provider_ids", "host_integrations", "digest"],
      "properties": {
        "schema_version": {"const": "oaw.configuration-snapshot/v2"}, "catalog_digest": {"$ref": "#/$defs/digest"}, "user_config_digest": {"$ref": "#/$defs/digest"}, "project_root": {"$ref": "#/$defs/optional_text"}, "project_config_digest": {"$ref": "#/$defs/optional_digest"}, "project_status": {"$ref": "#/$defs/optional_text"}, "project_reason": {"$ref": "#/$defs/optional_text"}, "settings": {"type": "array", "items": {"$ref": "#/$defs/provider_settings"}}, "provider_installations": {"type": "array", "items": {"$ref": "#/$defs/provider_installation"}}, "bounded_capability_defaults": {"type": "array", "items": {"$ref": "#/$defs/bounded_default"}}, "required_providers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_id"}}, "recommended_providers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_id"}}, "untrusted_provider_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_id"}}, "host_integrations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-integration.schema.json"}}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "host_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "kind", "reference", "topologies"],
      "properties": {"host": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}, "topologies": {"type": "array", "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}}}
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "deliverable_id", "input_digest", "generation", "classification", "classification_digest", "selection", "host_id", "host_session_digest", "environment_report_digest", "provider_inventory_digest", "configuration", "resolution_digest", "registry_digest", "provider_instances", "execution_graph", "topology", "environment_requirements", "environment_observations", "add_ons", "digest"],
      "properties": {
        "schema_version": {"const": "oaw.lifecycle-bundle/v3"}, "id": {"$ref": "#/$defs/text"}, "deliverable_id": {"$ref": "#/$defs/text"}, "input_digest": {"$ref": "#/$defs/digest"}, "generation": {"type": "integer", "minimum": 1}, "classification": {"$ref": "#/$defs/classification"}, "classification_digest": {"$ref": "#/$defs/digest"}, "selection": {"$ref": "#/$defs/selection"}, "host_id": {"$ref": "#/$defs/text"}, "host_session_digest": {"$ref": "#/$defs/digest"}, "environment_report_digest": {"$ref": "#/$defs/digest"}, "provider_inventory_digest": {"$ref": "#/$defs/digest"}, "configuration": {"$ref": "#/$defs/configuration"}, "resolution_digest": {"$ref": "#/$defs/digest"}, "registry_digest": {"$ref": "#/$defs/digest"}, "provider_instances": {"type": "array", "items": {"$ref": "#/$defs/provider_instance"}}, "execution_graph": {"$ref": "#/$defs/execution_graph"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "environment_requirements": {"type": "array", "items": {"$ref": "#/$defs/environment_requirement"}}, "environment_observations": {"type": "array", "items": {"$ref": "#/$defs/environment_observation"}}, "add_ons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "resource_lease": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "workflow_id", "grant_id", "bundle_id", "bundle_generation", "resource", "physical_root", "acquired_revision", "digest"],
      "properties": {"schema_version": {"const": "oaw.resource-lease/v1"}, "id": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "grant_id": {"$ref": "#/$defs/text"}, "bundle_id": {"$ref": "#/$defs/text"}, "bundle_generation": {"type": "integer", "minimum": 1}, "resource": {"$ref": "#/$defs/text"}, "physical_root": {"$ref": "#/$defs/text"}, "acquired_revision": {"type": "integer", "minimum": 1}, "released_revision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}
    },
    "processed_message": {
      "type": "object", "additionalProperties": false,
      "required": ["idempotency_key", "content_digest", "revision", "result_digest"],
      "properties": {"idempotency_key": {"$ref": "#/$defs/text"}, "content_digest": {"$ref": "#/$defs/digest"}, "revision": {"type": "integer", "minimum": 1}, "result_digest": {"$ref": "#/$defs/digest"}}
    },
    "projection_lag": {
      "type": "object", "additionalProperties": false,
      "required": ["revision", "digest", "reason"],
      "properties": {"revision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}, "reason": {"$ref": "#/$defs/text"}}
    }
  }
}
