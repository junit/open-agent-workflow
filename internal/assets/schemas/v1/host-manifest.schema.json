{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/host-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "host_id", "integration_level", "protocols", "binding_kinds", "features"],
  "properties": {
    "schema_version": {"const": "oaw.host-manifest/v1"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "host_id": {"$ref": "#/$defs/local_id"},
    "integration_level": {"enum": ["instruction-only", "runner-managed", "native-managed"]},
    "protocols": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"const": "oaw.runtime/v1"}},
    "binding_kinds": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["agent", "skill", "tool"]}},
    "features": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/feature"}}
  },
  "allOf": [
    {
      "if": {"properties": {"integration_level": {"const": "instruction-only"}}},
      "then": {
        "properties": {
          "protocols": {"maxItems": 0},
          "binding_kinds": {"maxItems": 0},
          "features": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"integration_level": {"enum": ["runner-managed", "native-managed"]}}},
      "then": {
        "properties": {
          "protocols": {"minItems": 1},
          "binding_kinds": {"minItems": 1},
          "features": {
            "allOf": [
              {"contains": {"const": "isolated-executor"}},
              {"contains": {"const": "exact-binding-invocation"}},
              {"contains": {"const": "pause"}},
              {"contains": {"const": "bundle-inheritance"}},
              {"contains": {"const": "evidence-return"}},
              {"contains": {"const": "invocation-deduplication"}},
              {"contains": {"const": "cancellation"}},
              {"contains": {"const": "normalized-observation"}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"integration_level": {"const": "native-managed"}}},
      "then": {"properties": {"features": {"contains": {"const": "native-invocation"}}}}
    },
    {
      "if": {"properties": {"integration_level": {"const": "runner-managed"}}},
      "then": {"properties": {"features": {"not": {"contains": {"const": "native-invocation"}}}}}
    }
  ],
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "feature": {
      "enum": [
        "isolated-executor",
        "exact-binding-invocation",
        "pause",
        "bundle-inheritance",
        "evidence-return",
        "invocation-deduplication",
        "cancellation",
        "normalized-observation",
        "native-invocation"
      ]
    }
  }
}
