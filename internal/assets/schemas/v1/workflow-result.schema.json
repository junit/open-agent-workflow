{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/workflow-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "workflow_id", "revision", "revision_digest", "diagnostics", "replayed", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-result/v1"},
    "kind": {"enum": ["STATE", "DISPATCH", "REJECTED"]},
    "workflow_id": {"$ref": "#/$defs/optional_text"},
    "revision": {"type": "integer", "minimum": 0},
    "revision_digest": {"$ref": "#/$defs/optional_digest"},
    "snapshot": {"$ref": "https://open-agent-workflow.dev/schemas/v1/workflow-snapshot.schema.json"},
    "dispatch": {"$ref": "#/$defs/dispatch"},
    "diagnostics": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/diagnostic"}},
    "replayed": {"type": "boolean"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "STATE"}}, "required": ["snapshot"], "not": {"required": ["dispatch"]}},
    {"properties": {"kind": {"const": "DISPATCH"}}, "required": ["snapshot", "dispatch"]},
    {"properties": {"kind": {"const": "REJECTED"}, "diagnostics": {"minItems": 1}}, "required": ["diagnostics"], "oneOf": [{"properties": {"workflow_id": {"const": ""}, "revision": {"const": 0}, "revision_digest": {"const": ""}}}, {"properties": {"workflow_id": {"$ref": "#/$defs/text"}, "revision": {"type": "integer", "minimum": 1}, "revision_digest": {"$ref": "#/$defs/digest"}}}], "not": {"anyOf": [{"required": ["snapshot"]}, {"required": ["dispatch"]}]}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
    "optional_text": {"type": "string", "maxLength": 512, "pattern": "^(?:|\\S(?:.*\\S)?)$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "detail"], "properties": {"code": {"$ref": "#/$defs/text"}, "detail": {"$ref": "#/$defs/text"}}},
    "grant_binding": {"type": "object", "additionalProperties": false, "required": ["host", "kind", "reference", "topologies"], "properties": {"host": {"$ref": "#/$defs/text"}, "kind": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}, "topologies": {"type": "array", "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}}}},
    "executor": {"type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": {"id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["main-agent", "isolated"]}}},
    "grant": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "invocation_id", "run_id", "request_id", "deliverable_id", "input_digest", "issued_revision", "generation", "provider_id", "provider_instance_digest", "descriptor_digest", "registry_digest", "catalog_digest", "capability_id", "binding", "executor", "effects", "resources", "termination_condition", "delegation_allow_list", "digest"],
      "properties": {
        "schema_version": {"const": "oaw.capability-grant/v1"}, "id": {"$ref": "#/$defs/text"}, "invocation_id": {"$ref": "#/$defs/text"}, "run_id": {"$ref": "#/$defs/text"}, "request_id": {"$ref": "#/$defs/text"}, "deliverable_id": {"$ref": "#/$defs/text"}, "input_digest": {"$ref": "#/$defs/digest"}, "issued_revision": {"type": "integer", "minimum": 1}, "generation": {"type": "integer", "minimum": 1}, "bundle_id": {"$ref": "#/$defs/optional_text"}, "node_id": {"$ref": "#/$defs/optional_text"}, "graph_digest": {"$ref": "#/$defs/optional_digest"}, "provider_id": {"$ref": "#/$defs/text"}, "provider_instance_digest": {"$ref": "#/$defs/digest"}, "descriptor_digest": {"$ref": "#/$defs/digest"}, "registry_digest": {"$ref": "#/$defs/digest"}, "catalog_digest": {"$ref": "#/$defs/digest"}, "capability_id": {"$ref": "#/$defs/text"}, "binding": {"$ref": "#/$defs/grant_binding"}, "executor": {"$ref": "#/$defs/executor"}, "effects": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "resources": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "termination_condition": {"$ref": "#/$defs/text"}, "delegation_allow_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "parent_grant_id": {"$ref": "#/$defs/optional_text"}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact_reference": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"], "properties": {"kind": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidence_requirement": {"type": "object", "additionalProperties": false, "required": ["kind", "minimum", "description"], "properties": {"kind": {"$ref": "#/$defs/text"}, "minimum": {"type": "integer", "minimum": 1}, "description": {"$ref": "#/$defs/text"}}},
    "environment_requirement": {"type": "object", "additionalProperties": false, "required": ["surface", "required", "accepted_dispositions"], "properties": {"surface": {"$ref": "#/$defs/text"}, "required": {"type": "boolean"}, "accepted_dispositions": {"type": "array", "uniqueItems": true, "items": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]}}}},
    "dispatch": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "id", "workflow_id", "request_id", "bundle_id", "bundle_generation", "bundle_digest", "node_id", "topology", "host_session_digest", "grant", "input_references", "evidence_requirements", "environment_requirements", "digest"],
      "properties": {
        "schema_version": {"const": "oaw.dispatch-packet/v1"}, "id": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "request_id": {"$ref": "#/$defs/text"}, "bundle_id": {"$ref": "#/$defs/text"}, "bundle_generation": {"type": "integer", "minimum": 1}, "bundle_digest": {"$ref": "#/$defs/digest"}, "node_id": {"$ref": "#/$defs/text"}, "ticket": {"$ref": "#/$defs/optional_text"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "host_session_digest": {"$ref": "#/$defs/digest"}, "grant": {"$ref": "#/$defs/grant"}, "input_references": {"type": "array", "items": {"$ref": "#/$defs/artifact_reference"}}, "evidence_requirements": {"type": "array", "items": {"$ref": "#/$defs/evidence_requirement"}}, "environment_requirements": {"type": "array", "items": {"$ref": "#/$defs/environment_requirement"}}, "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
