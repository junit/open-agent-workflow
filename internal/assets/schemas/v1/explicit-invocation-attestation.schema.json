{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/explicit-invocation-attestation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "issuer_host_id", "host_session_digest", "evidence_handle_digest", "invocation_nonce", "workflow_id", "bundle_id", "bundle_generation", "bundle_digest", "cursor", "provider_binding", "evidence", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.explicit-invocation-attestation/v1"},
    "id": {"type": "string", "pattern": "^invocation-attestation-[0-9a-f]{32}$"},
    "issuer_host_id": {"$ref": "#/$defs/local_id"},
    "host_session_digest": {"$ref": "#/$defs/digest"},
    "evidence_handle_digest": {"$ref": "#/$defs/digest"},
    "invocation_nonce": {"$ref": "#/$defs/text"},
    "workflow_id": {"type": "string", "pattern": "^workflow-[0-9a-f]{32}$"},
    "bundle_id": {"type": "string", "pattern": "^bundle-[0-9a-f]{32}$"},
    "bundle_generation": {"type": "integer", "minimum": 1},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "cursor": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/cursor"},
    "provider_binding": {"allOf": [{"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/provider_binding"}, {"properties": {"requires_explicit_invocation": {"const": true}}}]},
    "evidence": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/evidence"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"], "properties": {"kind": {"$ref": "#/$defs/text"}, "reference": {"type": "string", "pattern": "^evidence://.+", "maxLength": 2048}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
