{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://open-agent-workflow.dev/schemas/v1/profile-alias-set.schema.json",
  "type":"object","additionalProperties":false,"required":["schema_version","aliases"],
  "properties":{"schema_version":{"const":"oaw.profile-alias-set/v1"},"aliases":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["alias","recipe_id"],"properties":{"alias":{"type":"string","pattern":"^[A-Z0-9]+(?:-[A-Z0-9]+)*$"},"recipe_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"}}}}}
}
