{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/user-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "denied_providers", "provider_descriptors", "profile_recipes", "provider_pins", "binding_preferences", "project_trust"],
  "properties": {
    "schema_version": {"const": "oaw.user-config/v1"},
    "denied_providers": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_id"}},
    "provider_descriptors": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/content_reference"}},
    "profile_recipes": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/content_reference"}},
    "provider_pins": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/provider_pin"}},
    "binding_preferences": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/binding_preference"}},
    "project_trust": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/project_trust"}}
  },
  "$defs": {
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "path", "replace"],
      "properties": {"id": {"$ref": "#/$defs/qualified_id"}, "path": {"type": "string", "minLength": 1}, "replace": {"type": "boolean"}}
    },
    "provider_pin": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "location", "version"],
      "properties": {"id": {"$ref": "#/$defs/qualified_id"}, "location": {"type": "string"}, "version": {"type": "string"}},
      "anyOf": [{"properties": {"location": {"minLength": 1}}}, {"properties": {"version": {"minLength": 1}}}]
    },
    "binding_preference": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "capability_id", "host", "kind", "reference"],
      "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}, "host": {"type": "string", "minLength": 1}, "kind": {"enum": ["skill", "agent", "tool"]}, "reference": {"type": "string", "minLength": 1}}
    },
    "project_trust": {
      "type": "object", "additionalProperties": false,
      "required": ["root", "config_digest", "descriptor_digests", "recipe_digests"],
      "properties": {"root": {"type": "string", "minLength": 1}, "config_digest": {"$ref": "#/$defs/digest"}, "descriptor_digests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}, "recipe_digests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}}
    }
  }
}
