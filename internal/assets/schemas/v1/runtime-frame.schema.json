{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v1/runtime-frame.schema.json",
  "title": "Open Agent Workflow Runtime Frame",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "message_id", "idempotency_key"],
  "properties": {
    "schema_version": {"const": "oaw.runtime/v1"},
    "kind": {"enum": ["START", "CONTINUE", "INSPECT"]},
    "message_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "expected_revision": {"type": "integer", "minimum": 1},
    "start": {"type": "object"},
    "continue": {"type": "object"}
  }
}
