{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/host-binding-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "observations", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-binding-inventory/v2"},
    "host_id": {"$ref": "#/$defs/local_id"},
    "observations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observation"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "non_control_text": {"type": "string", "minLength": 1, "pattern": "^[^\\x00-\\x1f\\x7f]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "topologies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["CURRENT", "SUBAGENT"]}
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "kind", "reference", "topologies"],
      "properties": {
        "host": {"$ref": "#/$defs/local_id"},
        "kind": {"enum": ["skill", "agent", "tool"]},
        "reference": {"$ref": "#/$defs/non_control_text"},
        "topologies": {"$ref": "#/$defs/topologies"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "installation_key", "binding", "topologies", "source", "evidence_reference", "digest"],
      "properties": {
        "host_id": {"$ref": "#/$defs/local_id"},
        "installation_key": {"$ref": "#/$defs/non_control_text"},
        "binding": {"$ref": "#/$defs/binding"},
        "topologies": {"$ref": "#/$defs/topologies"},
        "source": {"enum": ["host-index", "host-filesystem", "native-probe"]},
        "evidence_reference": {"$ref": "#/$defs/non_control_text"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
