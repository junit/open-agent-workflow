{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/host-session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_id",
    "integration_id",
    "integration_version",
    "session_id",
    "supported_topologies",
    "provider_inventory_digest",
    "environment_report_digest",
    "sandbox_policy_digest",
    "approval_policy_digest",
    "digest"
  ],
  "properties": {
    "schema_version": {"const": "oaw.host-session/v2"},
    "host_id": {"$ref": "#/$defs/local_id"},
    "integration_id": {"$ref": "#/$defs/qualified_id"},
    "integration_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "session_id": {"$ref": "#/$defs/session_id"},
    "supported_topologies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["CURRENT", "SUBAGENT"]},
      "contains": {"const": "CURRENT"}
    },
    "provider_inventory_digest": {"$ref": "#/$defs/digest"},
    "environment_report_digest": {"$ref": "#/$defs/digest"},
    "sandbox_policy_digest": {"$ref": "#/$defs/optional_digest"},
    "approval_policy_digest": {"$ref": "#/$defs/optional_digest"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "session_id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"}
  }
}
