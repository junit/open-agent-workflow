{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/workflow-command.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "message_id", "idempotency_key", "workflow_id", "expected_revision"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-command/v2"},
    "kind": {"enum": ["START", "INSPECT", "PREPARE", "RECEIPT", "SWITCH", "CANCEL"]},
    "message_id": {"$ref": "#/$defs/optional_text"}, "idempotency_key": {"$ref": "#/$defs/optional_text"}, "workflow_id": {"$ref": "#/$defs/optional_text"}, "expected_revision": {"type": "integer", "minimum": 0},
    "start": {"$ref": "#/$defs/start"}, "prepare": {"$ref": "#/$defs/prepare"}, "receipt": {"$ref": "#/$defs/receipt"}, "switch": {"$ref": "#/$defs/switch"}, "cancel": {"$ref": "#/$defs/cancel"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "START"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"const": ""}, "expected_revision": {"const": 0}}, "required": ["start", "message_id", "idempotency_key"], "not": {"anyOf": [{"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "INSPECT"}, "message_id": {"const": ""}, "idempotency_key": {"const": ""}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"const": 0}}, "required": ["workflow_id"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "PREPARE"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"type": "integer", "minimum": 1}}, "required": ["prepare"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["receipt"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "RECEIPT"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"type": "integer", "minimum": 1}}, "required": ["receipt"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["switch"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "SWITCH"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"type": "integer", "minimum": 1}}, "required": ["switch"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["cancel"]}]}},
    {"properties": {"kind": {"const": "CANCEL"}, "message_id": {"$ref": "#/$defs/text"}, "idempotency_key": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/text"}, "expected_revision": {"type": "integer", "minimum": 1}}, "required": ["cancel"], "not": {"anyOf": [{"required": ["start"]}, {"required": ["prepare"]}, {"required": ["receipt"]}, {"required": ["switch"]}]}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"}, "optional_text": {"type": "string", "maxLength": 512, "pattern": "^(?:|\\S(?:.*\\S)?)$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cursor": {"type": "object", "additionalProperties": false, "required": ["slot_id", "kind", "unit_id", "ordinal"], "properties": {"slot_id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["binding", "host-action", "gate", "terminal"]}, "unit_id": {"$ref": "#/$defs/text"}, "ordinal": {"type": "integer", "minimum": 1}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["profile", "recipe_id", "recipe_digest", "profile_source", "topology", "topology_source", "add_ons", "alternatives", "overlays", "graph_selection_digest"], "properties": {"profile": {"$ref": "#/$defs/text"}, "recipe_id": {"$ref": "#/$defs/text"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "profile_source": {"const": "user-selection"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "topology_source": {"enum": ["user-selection", "host-only-option"]}, "add_ons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "alternatives": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json#/$defs/alternative"}}, "overlays": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}, "graph_selection_digest": {"$ref": "#/$defs/digest"}, "confirmation_digest": {"$ref": "#/$defs/digest"}}},
    "start": {"type": "object", "additionalProperties": false, "required": ["request_id", "deliverable_id", "input_digest", "active_ticket", "proposal", "selection", "host_session", "environment"], "properties": {"request_id": {"$ref": "#/$defs/text"}, "deliverable_id": {"$ref": "#/$defs/text"}, "input_digest": {"$ref": "#/$defs/digest"}, "active_ticket": {"$ref": "#/$defs/optional_text"}, "proposal": {"$ref": "https://open-agent-workflow.dev/schemas/v1/classification-proposal.schema.json"}, "selection": {"$ref": "#/$defs/selection"}, "host_session": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-session.schema.json"}, "environment": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-environment-report.schema.json"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"], "properties": {"kind": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidence_requirement": {"type": "object", "additionalProperties": false, "required": ["kind", "minimum", "description"], "properties": {"kind": {"$ref": "#/$defs/text"}, "minimum": {"type": "integer", "minimum": 1}, "description": {"$ref": "#/$defs/text"}}},
    "gate_attestation": {"$ref": "https://open-agent-workflow.dev/schemas/v1/gate-attestation.schema.json"},
    "prepare": {
      "type": "object", "additionalProperties": false,
      "required": ["requested_effects", "requested_resources", "termination_condition", "input_references", "evidence_requirements"],
      "properties": {
        "requested_effects": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "requested_resources": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "termination_condition": {"type": "string", "maxLength": 2048},
        "input_references": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/artifact"}},
        "evidence_requirements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence_requirement"}},
        "authorization": {"$ref": "https://open-agent-workflow.dev/schemas/v1/user-authorization.schema.json"},
        "invocation_attestation": {"$ref": "https://open-agent-workflow.dev/schemas/v1/explicit-invocation-attestation.schema.json"},
        "gate_attestation": {"$ref": "#/$defs/gate_attestation"}
      },
      "oneOf": [
        {"properties": {"requested_effects": {"minItems": 1}, "requested_resources": {"minItems": 1}, "termination_condition": {"$ref": "#/$defs/text"}}, "not": {"required": ["gate_attestation"]}},
        {"properties": {"requested_effects": {"maxItems": 0}, "requested_resources": {"maxItems": 0}, "termination_condition": {"const": ""}, "input_references": {"maxItems": 0}, "evidence_requirements": {"maxItems": 0}, "gate_attestation": {"$ref": "#/$defs/gate_attestation"}}, "required": ["gate_attestation"], "not": {"anyOf": [{"required": ["authorization"]}, {"required": ["invocation_attestation"]}]}}
      ]
    },
    "receipt": {"type": "object", "additionalProperties": false, "required": ["receipt", "signal", "stable_boundary"], "properties": {"receipt": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-invocation-receipt.schema.json"}, "signal": {"$ref": "#/$defs/optional_text"}, "stable_boundary": {"$ref": "#/$defs/optional_text"}}},
    "switch": {"type": "object", "additionalProperties": false, "required": ["boundary", "selection", "host_session", "environment"], "properties": {"boundary": {"$ref": "#/$defs/text"}, "selection": {"$ref": "#/$defs/selection"}, "host_session": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-session.schema.json"}, "environment": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-environment-report.schema.json"}}},
    "cancel": {"type": "object", "additionalProperties": false, "required": ["reason", "invocation_terminal"], "properties": {"reason": {"$ref": "#/$defs/text"}, "invocation_terminal": {"type": "boolean"}}}
  }
}
