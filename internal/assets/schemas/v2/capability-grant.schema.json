{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/capability-grant.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "workflow_id", "request_id", "bundle_id", "bundle_generation", "bundle_digest", "node_id", "topology", "host_session_digest", "provider_id", "provider_instance_digest", "capability_id", "binding", "effects", "resources", "termination_condition", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.capability-grant/v2"},
    "id": {"type": "string", "pattern": "^grant-[0-9a-f]{32}$"},
    "workflow_id": {"type": "string", "pattern": "^workflow-[0-9a-f]{32}$"},
    "request_id": {"$ref": "#/$defs/text"},
    "bundle_id": {"type": "string", "pattern": "^bundle-[0-9a-f]{32}$"},
    "bundle_generation": {"type": "integer", "minimum": 1},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "node_id": {"$ref": "#/$defs/local_id"},
    "topology": {"enum": ["CURRENT", "SUBAGENT"]},
    "host_session_digest": {"$ref": "#/$defs/digest"},
    "provider_id": {"$ref": "#/$defs/qualified_id"},
    "provider_instance_digest": {"$ref": "#/$defs/digest"},
    "capability_id": {"$ref": "#/$defs/local_id"},
    "binding": {"$ref": "#/$defs/binding"},
    "effects": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"enum": ["read-project", "write-project", "run-process", "git-local", "network-read"]}},
    "resources": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"enum": ["project", "project-worktree", "git-repository", "network", "credentials", "security", "data", "deployment"]}},
    "termination_condition": {"$ref": "#/$defs/text"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "kind", "reference", "topologies"],
      "properties": {
        "host": {"$ref": "#/$defs/text"},
        "kind": {"$ref": "#/$defs/text"},
        "reference": {"$ref": "#/$defs/text"},
        "topologies": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}}
      }
    }
  }
}
