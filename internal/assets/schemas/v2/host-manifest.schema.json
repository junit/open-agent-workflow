{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/host-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_version", "host_id", "control_surface", "protocols", "binding_kinds", "supported_topologies", "features"],
  "properties": {
    "schema_version": {"const": "oaw.host-manifest/v2"},
    "manifest_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "host_id": {"$ref": "#/$defs/local_id"},
    "control_surface": {"enum": ["policy", "host-native"]},
    "protocols": {"type": "array", "maxItems": 1, "uniqueItems": true, "items": {"const": "oaw.workflow/v1"}},
    "binding_kinds": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["agent", "skill", "tool"]}},
    "supported_topologies": {"$ref": "#/$defs/topologies"},
    "features": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/feature"}}
  },
  "allOf": [
    {
      "if": {"properties": {"control_surface": {"const": "policy"}}},
      "then": {
        "properties": {
          "protocols": {"maxItems": 0},
          "binding_kinds": {"maxItems": 0},
          "supported_topologies": {"const": ["CURRENT"]},
          "features": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"control_surface": {"const": "host-native"}}},
      "then": {
        "properties": {
          "protocols": {"const": ["oaw.workflow/v1"]},
          "binding_kinds": {"minItems": 1},
          "supported_topologies": {"contains": {"const": "CURRENT"}},
          "features": {
            "minItems": 2,
            "allOf": [
              {"contains": {"const": "provider-binding-inventory"}},
              {"contains": {"const": "normalized-receipts"}}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"supported_topologies": {"contains": {"const": "SUBAGENT"}}}},
      "then": {"properties": {"features": {"contains": {"const": "environment-reporting"}}}}
    }
  ],
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "topologies": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}},
    "feature": {"enum": ["provider-binding-inventory", "normalized-receipts", "invocation-deduplication", "pause", "cancellation", "environment-reporting"]}
  }
}
