{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/host-environment-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "session_id", "parent_session_id", "topology", "observations", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-environment-report/v2"},
    "session_id": {"$ref": "#/$defs/session_id"},
    "parent_session_id": {"type": "string", "maxLength": 512},
    "topology": {"enum": ["CURRENT", "SUBAGENT"]},
    "observations": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/observation"}
    },
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"topology": {"const": "CURRENT"}}},
      "then": {"properties": {"parent_session_id": {"const": ""}}}
    },
    {
      "if": {"properties": {"topology": {"const": "SUBAGENT"}}},
      "then": {"properties": {"parent_session_id": {"$ref": "#/$defs/session_id"}}}
    }
  ],
  "$defs": {
    "session_id": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "disposition", "source", "digest"],
      "properties": {
        "surface": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:.*\\S)?$"},
        "disposition": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]},
        "source": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
