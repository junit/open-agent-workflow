{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/host-conformance-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "transcript_digest", "verified_features", "diagnostics", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-conformance-report/v2"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "transcript_digest": {"$ref": "#/$defs/digest"},
    "verified_features": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/feature"}},
    "diagnostics": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature": {"enum": ["provider-binding-inventory", "normalized-receipts", "invocation-deduplication", "pause", "cancellation", "environment-reporting"]}
  }
}
