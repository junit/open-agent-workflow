{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/host-integration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "integration_version", "id", "manifest", "manifest_digest", "audit", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-integration/v2"},
    "integration_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "id": {"$ref": "#/$defs/qualified_id"},
    "manifest": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-manifest.schema.json"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "audit": {"$ref": "#/$defs/audit"},
    "conformance": {"$ref": "https://open-agent-workflow.dev/schemas/v2/host-conformance-report.schema.json"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {"properties": {"manifest": {"properties": {"control_surface": {"const": "policy"}}}}},
      "then": {
        "properties": {"audit": {"properties": {"status": {"const": "pending"}}}},
        "not": {"required": ["conformance"]}
      },
      "else": {
        "required": ["conformance"],
        "properties": {
          "audit": {"properties": {"status": {"const": "passed"}}}
        }
      }
    }
  ],
  "$defs": {
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest"],
      "properties": {
        "reference": {"type": "string", "minLength": 1, "maxLength": 2048},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "references", "digest"],
      "properties": {
        "status": {"enum": ["pending", "passed"]},
        "references": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/audit_reference"}},
        "digest": {"$ref": "#/$defs/digest"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"references": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"references": {"minItems": 1}}}}
      ]
    }
  }
}
