{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/workflow-snapshot.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "request_id", "deliverable_id", "revision", "status", "classification", "bundles", "active_generation", "cursor", "active_ticket", "grant_history", "user_authorizations", "invocation_attestations", "gate_attestations", "receipts", "resource_leases", "last_stable_boundary", "processed_messages", "projection_lag"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-snapshot/v2"}, "workflow_id": {"$ref": "#/$defs/workflow_id"}, "request_id": {"$ref": "#/$defs/text"}, "deliverable_id": {"$ref": "#/$defs/text"}, "revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["READY", "PREPARED", "IN_FLIGHT", "PAUSED", "FINISHED", "CANCELLED"]},
    "classification": {"type": "object", "additionalProperties": true}, "bundles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bundle"}}, "active_generation": {"type": "integer", "minimum": 1}, "cursor": {"$ref": "#/$defs/cursor"}, "active_ticket": {"type": "string", "maxLength": 512}, "active_grant": {"anyOf": [{"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}, {"type": "null"}]}, "grant_history": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}},
    "user_authorizations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v1/user-authorization.schema.json"}}, "invocation_attestations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v1/explicit-invocation-attestation.schema.json"}}, "gate_attestations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v1/gate-attestation.schema.json"}}, "receipts": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-invocation-receipt.schema.json"}}, "resource_leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}}, "last_stable_boundary": {"type": "string", "maxLength": 512}, "processed_messages": {"type": "array", "items": {"$ref": "#/$defs/message"}}, "projection_lag": {"type": "array", "items": {"$ref": "#/$defs/lag"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "workflow_id": {"type": "string", "pattern": "^workflow-[0-9a-f]{32}$"},
    "cursor": {"type": "object", "additionalProperties": false, "required": ["slot_id", "kind", "unit_id", "ordinal"], "properties": {"slot_id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["binding", "host-action", "gate", "terminal"]}, "unit_id": {"$ref": "#/$defs/text"}, "ordinal": {"type": "integer", "minimum": 1}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["profile", "recipe_id", "recipe_digest", "profile_source", "topology", "topology_source", "add_ons", "alternatives", "overlays", "graph_selection_digest"], "properties": {"profile": {"$ref": "#/$defs/text"}, "recipe_id": {"$ref": "#/$defs/text"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "profile_source": {"const": "user-selection"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "topology_source": {"enum": ["user-selection", "host-only-option"]}, "add_ons": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "alternatives": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json#/$defs/alternative"}}, "overlays": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "graph_selection_digest": {"$ref": "#/$defs/digest"}, "confirmation_digest": {"$ref": "#/$defs/digest"}}},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["schema_version", "id", "deliverable_id", "input_digest", "generation", "classification", "classification_digest", "selection", "recipe", "recipe_digest", "host_id", "host_session_digest", "host_manifest_digest", "environment_report_digest", "provider_inventory_digest", "host_feature_digest", "host_action_digest", "host_evidence_digest", "configuration", "resolution_digest", "registry_digest", "provider_instances", "execution_graph", "topology", "environment_requirements", "add_ons", "digest"], "properties": {"schema_version": {"const": "oaw.lifecycle-bundle/v4"}, "id": {"type": "string", "pattern": "^bundle-[0-9a-f]{32}$"}, "deliverable_id": {"$ref": "#/$defs/text"}, "input_digest": {"$ref": "#/$defs/digest"}, "generation": {"type": "integer", "minimum": 1}, "classification": {"type": "object", "additionalProperties": true}, "classification_digest": {"$ref": "#/$defs/digest"}, "selection": {"$ref": "#/$defs/selection"}, "recipe": {"$ref": "https://open-agent-workflow.dev/schemas/v3/profile-recipe.schema.json"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "host_id": {"$ref": "#/$defs/text"}, "host_session_digest": {"$ref": "#/$defs/digest"}, "host_manifest_digest": {"$ref": "#/$defs/digest"}, "environment_report_digest": {"$ref": "#/$defs/digest"}, "provider_inventory_digest": {"$ref": "#/$defs/digest"}, "host_feature_digest": {"$ref": "#/$defs/digest"}, "host_action_digest": {"$ref": "#/$defs/digest"}, "host_evidence_digest": {"$ref": "#/$defs/digest"}, "configuration": {"type": "object", "additionalProperties": true}, "resolution_digest": {"$ref": "#/$defs/digest"}, "registry_digest": {"$ref": "#/$defs/digest"}, "provider_instances": {"type": "array"}, "execution_graph": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "environment_requirements": {"type": "array"}, "add_ons": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "digest": {"$ref": "#/$defs/digest"}}},
    "lease": {"type": "object", "additionalProperties": false, "required": ["schema_version", "id", "workflow_id", "grant_id", "bundle_id", "bundle_generation", "cursor", "resource", "physical_root", "acquired_revision", "digest"], "properties": {"schema_version": {"const": "oaw.resource-lease/v1"}, "id": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/workflow_id"}, "grant_id": {"$ref": "#/$defs/text"}, "bundle_id": {"$ref": "#/$defs/text"}, "bundle_generation": {"type": "integer", "minimum": 1}, "cursor": {"$ref": "#/$defs/cursor"}, "resource": {"$ref": "#/$defs/text"}, "physical_root": {"$ref": "#/$defs/text"}, "acquired_revision": {"type": "integer", "minimum": 1}, "released_revision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "message": {"type": "object", "additionalProperties": false, "required": ["idempotency_key", "content_digest", "revision", "result_digest"], "properties": {"idempotency_key": {"$ref": "#/$defs/text"}, "content_digest": {"$ref": "#/$defs/digest"}, "revision": {"type": "integer", "minimum": 1}, "result_digest": {"$ref": "#/$defs/digest"}}},
    "lag": {"type": "object", "additionalProperties": false, "required": ["revision", "digest", "reason"], "properties": {"revision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}, "reason": {"$ref": "#/$defs/text"}}}
  }
}
