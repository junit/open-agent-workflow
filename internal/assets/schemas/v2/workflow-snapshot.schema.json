{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/workflow-snapshot.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "request_id", "deliverable_id", "revision", "status", "classification", "bundles", "active_generation", "cursor", "active_ticket", "grant_history", "user_authorizations", "invocation_attestations", "gate_attestations", "receipts", "resource_leases", "last_stable_boundary", "processed_messages", "projection_lag"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-snapshot/v2"}, "workflow_id": {"$ref": "#/$defs/workflow_id"}, "request_id": {"$ref": "#/$defs/text"}, "deliverable_id": {"$ref": "#/$defs/text"}, "revision": {"type": "integer", "minimum": 1}, "status": {"enum": ["READY", "PREPARED", "IN_FLIGHT", "PAUSED", "FINISHED", "CANCELLED"]},
    "classification": {"$ref": "#/$defs/classification"}, "bundles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bundle"}}, "active_generation": {"type": "integer", "minimum": 1}, "cursor": {"$ref": "#/$defs/cursor"}, "active_ticket": {"type": "string", "maxLength": 512}, "active_grant": {"anyOf": [{"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}, {"type": "null"}]}, "active_dispatch_digest": {"$ref": "#/$defs/digest"}, "grant_history": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}},
    "user_authorizations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v1/user-authorization.schema.json"}}, "invocation_attestations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v1/explicit-invocation-attestation.schema.json"}}, "gate_attestations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v1/gate-attestation.schema.json"}}, "receipts": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-invocation-receipt.schema.json"}}, "resource_leases": {"type": "array", "items": {"$ref": "#/$defs/lease"}}, "last_stable_boundary": {"type": "string", "maxLength": 512}, "processed_messages": {"type": "array", "items": {"$ref": "#/$defs/message"}}, "projection_lag": {"type": "array", "items": {"$ref": "#/$defs/lag"}}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["PREPARED", "IN_FLIGHT"]}}}, "then": {"required": ["active_grant", "active_dispatch_digest"], "properties": {"active_grant": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}}}},
    {"if": {"properties": {"status": {"enum": ["READY", "FINISHED", "CANCELLED"]}}}, "then": {"not": {"anyOf": [{"required": ["active_dispatch_digest"]}, {"required": ["active_grant"], "properties": {"active_grant": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}}}]}}},
    {"if": {"required": ["active_grant"], "properties": {"active_grant": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}}}, "then": {"required": ["active_dispatch_digest"]}},
    {"if": {"required": ["active_dispatch_digest"]}, "then": {"required": ["active_grant"], "properties": {"active_grant": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"}, "optional_text": {"type": "string", "maxLength": 2048, "pattern": "^(?:|\\S(?:.*\\S)?)$"}, "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "optional_digest": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"}, "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"}, "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}, "workflow_id": {"type": "string", "pattern": "^workflow-[0-9a-f]{32}$"},
