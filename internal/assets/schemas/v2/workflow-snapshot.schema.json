    "bounded_default": {"type": "object", "additionalProperties": false, "required": ["id", "provider_id", "capability_id"], "properties": {"id": {"$ref": "#/$defs/text"}, "provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}}},
    "provider_settings": {"type": "object", "additionalProperties": false, "required": ["provider_id", "host_id", "disabled", "pin", "preferences", "capability_limit", "digest"], "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "disabled": {"type": "boolean"}, "pin": {"anyOf": [{"$ref": "#/$defs/config_pin"}, {"type": "null"}]}, "preferences": {"type": "array", "items": {"$ref": "#/$defs/binding_preference"}}, "capability_limit": {"type": "array", "items": {"$ref": "#/$defs/local_id"}}, "digest": {"$ref": "#/$defs/digest"}}},
    "configuration": {"type": "object", "additionalProperties": false, "required": ["schema_version", "catalog_digest", "user_config_digest", "project_root", "project_config_digest", "project_status", "project_reason", "settings", "provider_installations", "bounded_capability_defaults", "required_providers", "recommended_providers", "untrusted_provider_ids", "host_integrations", "digest"], "properties": {"schema_version": {"const": "oaw.configuration-snapshot/v2"}, "catalog_digest": {"$ref": "#/$defs/digest"}, "user_config_digest": {"$ref": "#/$defs/digest"}, "project_root": {"$ref": "#/$defs/optional_text"}, "project_config_digest": {"$ref": "#/$defs/optional_digest"}, "project_status": {"enum": ["absent", "trusted", "untrusted"]}, "project_reason": {"$ref": "#/$defs/optional_text"}, "settings": {"type": "array", "items": {"$ref": "#/$defs/provider_settings"}}, "provider_installations": {"type": "array", "items": {"$ref": "#/$defs/provider_installation"}}, "bounded_capability_defaults": {"type": "array", "items": {"$ref": "#/$defs/bounded_default"}}, "required_providers": {"type": "array", "items": {"$ref": "#/$defs/qualified_id"}}, "recommended_providers": {"type": "array", "items": {"$ref": "#/$defs/qualified_id"}}, "untrusted_provider_ids": {"type": "array", "items": {"$ref": "#/$defs/qualified_id"}}, "host_integrations": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v3/host-integration.schema.json"}}, "digest": {"$ref": "#/$defs/digest"}}},
    "cursor": {"type": "object", "additionalProperties": false, "required": ["slot_id", "kind", "unit_id", "ordinal"], "properties": {"slot_id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["binding", "host-action", "gate", "terminal"]}, "unit_id": {"$ref": "#/$defs/text"}, "ordinal": {"type": "integer", "minimum": 1}}},
    "selection": {"type": "object", "additionalProperties": false, "required": ["profile", "recipe_id", "recipe_digest", "profile_source", "topology", "topology_source", "add_ons", "alternatives", "overlays", "graph_selection_digest"], "properties": {"profile": {"$ref": "#/$defs/text"}, "recipe_id": {"$ref": "#/$defs/text"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "profile_source": {"const": "user-selection"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "topology_source": {"enum": ["user-selection", "host-only-option"]}, "add_ons": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "alternatives": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json#/$defs/alternative"}}, "overlays": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "graph_selection_digest": {"$ref": "#/$defs/digest"}, "confirmation_digest": {"$ref": "#/$defs/digest"}}},
    "bundle": {"type": "object", "additionalProperties": false, "required": ["schema_version", "id", "deliverable_id", "input_digest", "generation", "classification", "classification_digest", "selection", "recipe", "recipe_digest", "host_id", "host_session_digest", "reporter_identity_digest", "host_manifest_digest", "environment_report_digest", "provider_inventory_digest", "host_feature_digest", "host_action_digest", "host_evidence_digest", "configuration", "resolution_digest", "registry_digest", "provider_instances", "execution_graph", "topology", "environment_requirements", "add_ons", "digest"], "properties": {"schema_version": {"const": "oaw.lifecycle-bundle/v4"}, "id": {"type": "string", "pattern": "^bundle-[0-9a-f]{32}$"}, "deliverable_id": {"$ref": "#/$defs/text"}, "input_digest": {"$ref": "#/$defs/digest"}, "generation": {"type": "integer", "minimum": 1}, "classification": {"$ref": "#/$defs/classification"}, "classification_digest": {"$ref": "#/$defs/digest"}, "selection": {"$ref": "#/$defs/selection"}, "recipe": {"$ref": "https://open-agent-workflow.dev/schemas/v3/profile-recipe.schema.json"}, "recipe_digest": {"$ref": "#/$defs/digest"}, "host_id": {"$ref": "#/$defs/text"}, "host_session_digest": {"$ref": "#/$defs/digest"}, "reporter_identity_digest": {"$ref": "#/$defs/digest"}, "host_manifest_digest": {"$ref": "#/$defs/digest"}, "environment_report_digest": {"$ref": "#/$defs/digest"}, "provider_inventory_digest": {"$ref": "#/$defs/digest"}, "host_feature_digest": {"$ref": "#/$defs/digest"}, "host_action_digest": {"$ref": "#/$defs/digest"}, "host_evidence_digest": {"$ref": "#/$defs/digest"}, "configuration": {"$ref": "#/$defs/configuration"}, "resolution_digest": {"$ref": "#/$defs/digest"}, "registry_digest": {"$ref": "#/$defs/digest"}, "provider_instances": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json#/$defs/provider_instance"}}, "execution_graph": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json"}, "topology": {"enum": ["CURRENT", "SUBAGENT"]}, "environment_requirements": {"type": "array", "items": {"$ref": "https://open-agent-workflow.dev/schemas/v4/execution-graph.schema.json#/$defs/environment_requirement"}}, "add_ons": {"type": "array", "items": {"$ref": "#/$defs/text"}}, "digest": {"$ref": "#/$defs/digest"}}},
    "lease": {"type": "object", "additionalProperties": false, "required": ["schema_version", "id", "workflow_id", "grant_id", "bundle_id", "bundle_generation", "cursor", "resource", "physical_root", "acquired_revision", "digest"], "properties": {"schema_version": {"const": "oaw.resource-lease/v1"}, "id": {"$ref": "#/$defs/text"}, "workflow_id": {"$ref": "#/$defs/workflow_id"}, "grant_id": {"$ref": "#/$defs/text"}, "bundle_id": {"$ref": "#/$defs/text"}, "bundle_generation": {"type": "integer", "minimum": 1}, "cursor": {"$ref": "#/$defs/cursor"}, "resource": {"$ref": "#/$defs/text"}, "physical_root": {"$ref": "#/$defs/text"}, "acquired_revision": {"type": "integer", "minimum": 1}, "released_revision": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}}},
    "message": {"type": "object", "additionalProperties": false, "required": ["idempotency_key", "content_digest", "revision", "result_digest"], "properties": {"idempotency_key": {"$ref": "#/$defs/text"}, "content_digest": {"$ref": "#/$defs/digest"}, "revision": {"type": "integer", "minimum": 1}, "result_digest": {"$ref": "#/$defs/digest"}}},
