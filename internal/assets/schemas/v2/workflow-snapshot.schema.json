    "config_pin": {"type": "object", "additionalProperties": false, "required": ["provider_id", "host_id", "installation_key", "evidence_digest"], "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "installation_key": {"$ref": "#/$defs/text"}, "evidence_digest": {"$ref": "#/$defs/digest"}, "location": {"$ref": "#/$defs/optional_text"}, "version": {"$ref": "#/$defs/optional_text"}}},
    "provider_installation": {"type": "object", "additionalProperties": false, "required": ["provider_id", "host_id", "surface_id", "location", "discovery_probe_id"], "properties": {"provider_id": {"$ref": "#/$defs/qualified_id"}, "host_id": {"$ref": "#/$defs/text"}, "surface_id": {"$ref": "#/$defs/text"}, "location": {"$ref": "#/$defs/text"}, "discovery_probe_id": {"$ref": "#/$defs/text"}}},
