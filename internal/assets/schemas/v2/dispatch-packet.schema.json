{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/dispatch-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "workflow_id", "request_id", "bundle_id", "bundle_generation", "bundle_digest", "cursor", "target_kind", "topology", "host_session_digest", "environment_report_digest", "grant", "input_references", "evidence_requirements", "environment_requirements", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.dispatch-packet/v2"},
    "id": {"type": "string", "pattern": "^dispatch-[0-9a-f]{32}$"},
    "workflow_id": {"type": "string", "pattern": "^workflow-[0-9a-f]{32}$"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 512},
    "bundle_id": {"type": "string", "pattern": "^bundle-[0-9a-f]{32}$"},
    "bundle_generation": {"type": "integer", "minimum": 1},
    "bundle_digest": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/digest"},
    "cursor": {"$ref": "#/$defs/cursor"},
    "target_kind": {"enum": ["provider-binding", "host-action"]},
    "ticket": {"type": "string", "maxLength": 512},
    "topology": {"enum": ["CURRENT", "SUBAGENT"]},
    "host_session_digest": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/digest"},
    "environment_report_digest": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/digest"},
    "grant": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json"},
    "authorization": {"anyOf": [{"$ref": "https://open-agent-workflow.dev/schemas/v1/user-authorization.schema.json"}, {"type": "null"}]},
    "invocation_attestation": {"anyOf": [{"$ref": "https://open-agent-workflow.dev/schemas/v1/explicit-invocation-attestation.schema.json"}, {"type": "null"}]},
    "input_references": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/artifact_reference"}},
    "evidence_requirements": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence_requirement"}},
    "environment_requirements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["surface", "required", "accepted_dispositions"], "properties": {"surface": {"type": "string"}, "required": {"type": "boolean"}, "accepted_dispositions": {"type": "array", "items": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]}}}}},
    "digest": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cursor": {"type": "object", "additionalProperties": false, "required": ["slot_id", "kind", "unit_id", "ordinal"], "properties": {"slot_id": {"$ref": "#/$defs/text"}, "kind": {"enum": ["binding", "host-action"]}, "unit_id": {"$ref": "#/$defs/text"}, "ordinal": {"type": "integer", "minimum": 1}}},
    "artifact_reference": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"], "properties": {"kind": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidence_requirement": {"type": "object", "additionalProperties": false, "required": ["kind", "minimum", "description"], "properties": {"kind": {"$ref": "#/$defs/text"}, "minimum": {"type": "integer", "minimum": 1}, "description": {"$ref": "#/$defs/text"}}}
  }
}
