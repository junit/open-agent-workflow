{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/workflow-revision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workflow_id", "revision", "predecessor_digest", "message_id", "idempotency_key", "message_digest", "event", "snapshot", "result", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.workflow-revision/v2"},
    "workflow_id": {"$ref": "#/$defs/text"},
    "revision": {"type": "integer", "minimum": 1},
    "predecessor_digest": {"$ref": "#/$defs/optional_digest"},
    "message_id": {"$ref": "#/$defs/text"},
    "idempotency_key": {"$ref": "#/$defs/text"},
    "message_digest": {"$ref": "#/$defs/digest"},
    "event": {"$ref": "#/$defs/text"},
    "snapshot": {"$ref": "https://open-agent-workflow.dev/schemas/v2/workflow-snapshot.schema.json"},
    "result": {"$ref": "https://open-agent-workflow.dev/schemas/v2/workflow-result.schema.json"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"}
  }
}
