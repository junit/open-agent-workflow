{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v2/profile-recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_version", "id", "display_name", "required_responsibilities", "nodes", "incident_routes", "entry", "terminal_gates", "stable_boundaries", "environment_requirements"],
  "properties": {
    "schema_version": {"const": "oaw.profile-recipe/v2"},
    "recipe_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "id": {"$ref": "#/$defs/qualified_id"},
    "display_name": {"type": "string", "minLength": 1},
    "required_responsibilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nodes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/node"}},
    "incident_routes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/route"}},
    "entry": {"type": "string", "minLength": 1},
    "terminal_gates": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "stable_boundaries": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "environment_requirements": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/environment_requirement"}}
  },
  "$defs": {
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "capability_id"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/qualified_id"},
        "capability_id": {"$ref": "#/$defs/local_id"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "target"],
      "properties": {
        "signal": {"enum": ["succeeded", "finding", "remediated"]},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "responsibility", "selector", "transitions"],
          "properties": {
            "id": {"$ref": "#/$defs/local_id"},
            "kind": {"enum": ["phase", "incident-handler", "gate"]},
            "responsibility": {"type": "string", "minLength": 1},
            "selector": {"$ref": "#/$defs/selector"},
            "optional": {"type": "boolean"},
            "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "responsibility", "selector", "phase", "transitions"],
          "properties": {
            "id": {"$ref": "#/$defs/local_id"},
            "kind": {"const": "procedure"},
            "responsibility": {"type": "string", "minLength": 1},
            "selector": {"$ref": "#/$defs/selector"},
            "phase": {"type": "string", "minLength": 1},
            "optional": {"type": "boolean"},
            "transitions": {"type": "array", "maxItems": 0}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "kind", "responsibility", "selector", "transitions"],
          "properties": {
            "id": {"$ref": "#/$defs/local_id"},
            "kind": {"const": "checkpoint"},
            "responsibility": {"type": "string"},
            "selector": {"$ref": "#/$defs/selector"},
            "optional": {"type": "boolean"},
            "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}
          }
        }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incident", "handler"],
      "properties": {
        "incident": {"enum": ["functional-failure", "build-failure", "dependency-failure", "type-failure", "security-finding"]},
        "handler": {"type": "string", "minLength": 1}
      }
    },
    "environment_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "required", "accepted_dispositions"],
      "properties": {
        "surface": {"$ref": "#/$defs/local_id"},
        "required": {"type": "boolean"},
        "accepted_dispositions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["inherited", "host-configured", "restricted", "unknown", "unavailable"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {"properties": {"accepted_dispositions": {"minItems": 1}}}
        }
      ]
    }
  }
}
