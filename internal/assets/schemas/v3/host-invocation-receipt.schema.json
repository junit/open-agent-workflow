{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v3/host-invocation-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "workflow_id", "bundle_id", "bundle_generation", "bundle_digest", "cursor", "topology", "host_session_digest", "dispatch_digest", "invocation_handle", "context_freshness", "environment_report_digest", "outcome", "failure_code", "outputs", "evidence", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-invocation-receipt/v3"},
    "kind": {"enum": ["STARTED", "PAUSED", "COMPLETED", "FAILED", "CANCELLED"]},
    "workflow_id": {"$ref": "#/$defs/workflow_id"},
    "bundle_id": {"$ref": "#/$defs/bundle_id"},
    "bundle_generation": {"type": "integer", "minimum": 1},
    "bundle_digest": {"$ref": "#/$defs/digest"},
    "cursor": {"$ref": "https://open-agent-workflow.dev/schemas/v3/capability-grant.schema.json#/$defs/cursor"},
    "topology": {"enum": ["CURRENT", "SUBAGENT"]},
    "host_session_digest": {"$ref": "#/$defs/digest"},
    "dispatch_digest": {"$ref": "#/$defs/digest"},
    "invocation_handle": {"type": "string", "maxLength": 1024},
    "context_freshness": {"enum": ["shared", "fresh"]},
    "environment_report_digest": {"$ref": "#/$defs/digest"},
    "outcome": {"type": "string", "maxLength": 512},
    "failure_code": {"type": "string", "maxLength": 128},
    "outputs": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/output"}},
    "evidence": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/evidence"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {"if": {"properties": {"topology": {"const": "CURRENT"}}}, "then": {"properties": {"invocation_handle": {"const": ""}, "context_freshness": {"const": "shared"}}}},
    {"if": {"properties": {"topology": {"const": "SUBAGENT"}}}, "then": {"properties": {"invocation_handle": {"$ref": "#/$defs/text"}, "context_freshness": {"const": "fresh"}}}},
    {"if": {"properties": {"kind": {"const": "STARTED"}}}, "then": {"properties": {"outcome": {"const": ""}, "failure_code": {"const": ""}, "outputs": {"maxItems": 0}, "evidence": {"maxItems": 0}}}},
    {"if": {"properties": {"kind": {"const": "PAUSED"}}}, "then": {"properties": {"outcome": {"const": "paused"}, "failure_code": {"const": ""}, "outputs": {"maxItems": 0}, "evidence": {"maxItems": 0}}}},
    {"if": {"properties": {"kind": {"const": "COMPLETED"}}}, "then": {"properties": {"outcome": {"$ref": "#/$defs/text"}, "failure_code": {"const": ""}, "outputs": {"minItems": 1}, "evidence": {"minItems": 1}}}},
    {"if": {"properties": {"kind": {"const": "FAILED"}}}, "then": {"properties": {"outcome": {"const": "failed"}, "failure_code": {"$ref": "#/$defs/text"}, "outputs": {"maxItems": 0}, "evidence": {"minItems": 1}}}},
    {"if": {"properties": {"kind": {"const": "CANCELLED"}}}, "then": {"properties": {"outcome": {"const": "cancelled"}, "failure_code": {"const": ""}, "outputs": {"maxItems": 0}, "evidence": {"maxItems": 0}}}}
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workflow_id": {"type": "string", "pattern": "^workflow-[0-9a-f]{32}$"},
    "bundle_id": {"type": "string", "pattern": "^bundle-[0-9a-f]{32}$"},
    "output": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "schema", "reference", "digest"], "properties": {"artifact_id": {"$ref": "#/$defs/text"}, "schema": {"$ref": "#/$defs/text"}, "reference": {"type": "string", "minLength": 1, "maxLength": 2048}, "digest": {"$ref": "#/$defs/digest"}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "digest"], "properties": {"kind": {"$ref": "#/$defs/text"}, "reference": {"type": "string", "minLength": 1, "maxLength": 2048}, "digest": {"$ref": "#/$defs/digest"}}}
  }
}
