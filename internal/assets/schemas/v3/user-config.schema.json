{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v3/user-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "denied_providers", "provider_descriptors", "profile_recipes", "host_integrations", "provider_installations", "provider_pins", "binding_preferences", "bounded_capability_defaults", "project_trust"],
  "properties": {
    "schema_version": {"const": "oaw.user-config/v3"},
    "denied_providers": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/qualified_id"}},
    "provider_descriptors": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/content_reference"}},
    "profile_recipes": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/content_reference"}},
    "host_integrations": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/content_reference"}},
    "provider_installations": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/provider_installation"}},
    "provider_pins": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/provider_pin"}},
    "binding_preferences": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/binding_preference"}},
    "bounded_capability_defaults": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/bounded_capability_default"}},
    "project_trust": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/project_trust"}}
  },
  "$defs": {
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "replace"],
      "properties": {"id": {"$ref": "#/$defs/qualified_id"}, "path": {"type": "string", "minLength": 1}, "replace": {"type": "boolean"}}
    },
    "provider_installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "host_id", "surface_id", "location", "discovery_probe_id"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/qualified_id"},
        "host_id": {"$ref": "#/$defs/local_id"},
        "surface_id": {"$ref": "#/$defs/local_id"},
        "location": {"type": "string", "minLength": 1},
        "discovery_probe_id": {"$ref": "#/$defs/local_id"}
      }
    },
    "provider_pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "host_id", "installation_key", "evidence_digest"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/qualified_id"},
        "host_id": {"$ref": "#/$defs/local_id"},
        "installation_key": {"type": "string", "minLength": 1},
        "evidence_digest": {"$ref": "#/$defs/digest"},
        "location": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "binding_preference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "capability_id", "host_id", "kind", "reference"],
      "properties": {
        "provider_id": {"$ref": "#/$defs/qualified_id"},
        "capability_id": {"$ref": "#/$defs/local_id"},
        "host_id": {"$ref": "#/$defs/local_id"},
        "kind": {"enum": ["skill", "agent", "role", "instruction", "tool"]},
        "reference": {"type": "string", "minLength": 1}
      }
    },
    "bounded_capability_default": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "provider_id", "capability_id"],
      "properties": {"id": {"$ref": "#/$defs/local_id"}, "provider_id": {"$ref": "#/$defs/qualified_id"}, "capability_id": {"$ref": "#/$defs/local_id"}}
    },
    "project_trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "config_digest", "descriptor_digests", "recipe_digests"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "config_digest": {"$ref": "#/$defs/digest"},
        "descriptor_digests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
        "recipe_digests": {"type": "array", "maxItems": 1024, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}}
      }
    }
  }
}
