{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v3/host-session.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "integration_id", "integration_version", "session_id", "manifest_digest", "supported_topologies", "provider_inventory_digest", "feature_observations", "feature_digest", "host_action_observations", "host_action_digest", "environment_report_digest", "sandbox_policy_digest", "approval_policy_digest", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-session/v3"},
    "host_id": {"$ref": "#/$defs/local_id"},
    "integration_id": {"$ref": "#/$defs/qualified_id"},
    "integration_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "session_id": {"$ref": "#/$defs/text"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "supported_topologies": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}, "contains": {"const": "CURRENT"}},
    "provider_inventory_digest": {"$ref": "#/$defs/digest"},
    "feature_observations": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/feature_observation"}},
    "feature_digest": {"$ref": "#/$defs/digest"},
    "host_action_observations": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/action_observation"}},
    "host_action_digest": {"$ref": "#/$defs/digest"},
    "environment_report_digest": {"$ref": "#/$defs/digest"},
    "sandbox_policy_digest": {"$ref": "#/$defs/optional_digest"},
    "approval_policy_digest": {"$ref": "#/$defs/optional_digest"},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "optional_digest": {"type": "string", "pattern": "^(?:|[0-9a-f]{64})$"},
    "availability": {"enum": ["available", "host-configured", "unavailable", "unknown"]},
    "source": {"enum": ["native-api", "live-host-index", "live-host-filesystem", "static-configuration"]},
    "evidence": {"type": "string", "pattern": "^evidence://[^\\x00-\\x1f\\x7f]+$"},
    "feature_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["feature", "state", "source", "evidence_reference", "digest"],
      "properties": {
        "feature": {"enum": ["child-delegation", "nested-child-delegation", "nested-parallel-child-delegation", "parallel-child-delegation"]},
        "state": {"$ref": "#/$defs/availability"}, "source": {"$ref": "#/$defs/source"}, "evidence_reference": {"$ref": "#/$defs/evidence"}, "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "host_action": {
      "oneOf": [
        {"const": {"id": "closeout.execute", "input_schema": "oaw.host-action.closeout-input/v1", "outcome_schema": "oaw.host-action.closeout-outcome/v1", "maximum_effects": ["git-local", "network-mutation", "read-project", "run-process"], "resources": ["git-repository", "network", "project-worktree"]}},
        {"const": {"id": "verification.execute", "input_schema": "oaw.host-action.verification-input/v1", "outcome_schema": "oaw.host-action.verification-outcome/v1", "maximum_effects": ["read-project", "run-process"], "resources": ["project"]}},
        {"const": {"id": "workspace.prepare-or-confirm", "input_schema": "oaw.host-action.workspace-input/v1", "outcome_schema": "oaw.host-action.workspace-outcome/v1", "maximum_effects": ["git-local", "read-project", "run-process", "write-project"], "resources": ["git-repository", "project-worktree"]}}
      ]
    },
    "action_observation": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "state", "source", "evidence_reference", "digest"],
      "properties": {"action": {"$ref": "#/$defs/host_action"}, "state": {"$ref": "#/$defs/availability"}, "source": {"$ref": "#/$defs/source"}, "evidence_reference": {"$ref": "#/$defs/evidence"}, "digest": {"$ref": "#/$defs/digest"}}
    }
  }
}
