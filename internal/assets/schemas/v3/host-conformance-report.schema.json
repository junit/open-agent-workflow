{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v3/host-conformance-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "transcript_digest", "verified_features", "verified_delegation_features", "verified_host_action_ids", "diagnostics", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-conformance-report/v3"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "transcript_digest": {"$ref": "#/$defs/digest"},
    "verified_features": {"type": "array", "maxItems": 6, "uniqueItems": true, "items": {"enum": ["cancellation", "environment-reporting", "invocation-deduplication", "normalized-receipts", "pause", "provider-binding-inventory"]}},
    "verified_delegation_features": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["child-delegation", "nested-child-delegation", "nested-parallel-child-delegation", "parallel-child-delegation"]}},
    "verified_host_action_ids": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"enum": ["closeout.execute", "verification.execute", "workspace.prepare-or-confirm"]}},
    "diagnostics": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
