{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-agent-workflow.dev/schemas/v3/host-binding-inventory.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "observations", "digest"],
  "properties": {
    "schema_version": {"const": "oaw.host-binding-inventory/v3"},
    "host_id": {"$ref": "#/$defs/local_id"},
    "observations": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/observation"}},
    "digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "local_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$"},
    "qualified_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*/[a-z0-9][a-z0-9._-]*$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^[^\\x00-\\x1f\\x7f]+$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tree_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "topologies": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["CURRENT", "SUBAGENT"]}},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "provider_id", "installation_key", "distribution_id", "binding_id", "surface", "kind", "reference", "invocation", "binding_tree_digest", "topologies", "source", "evidence_reference", "digest"],
      "properties": {
        "host_id": {"$ref": "#/$defs/local_id"},
        "provider_id": {"$ref": "#/$defs/qualified_id"},
        "installation_key": {"$ref": "#/$defs/text"},
        "distribution_id": {"$ref": "#/$defs/local_id"},
        "binding_id": {"$ref": "#/$defs/local_id"},
        "surface": {"$ref": "#/$defs/text"},
        "kind": {"enum": ["agent", "instruction", "role", "skill", "tool"]},
        "reference": {"$ref": "#/$defs/text"},
        "invocation": {"enum": ["human-explicit", "host", "internal", "model"]},
        "binding_tree_digest": {"$ref": "#/$defs/tree_digest"},
        "topologies": {"$ref": "#/$defs/topologies"},
        "source": {"enum": ["native-api", "live-host-index", "live-host-filesystem"]},
        "evidence_reference": {"type": "string", "pattern": "^evidence://[^\\x00-\\x1f\\x7f]+$"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
